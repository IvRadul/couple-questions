JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=525600

# Локально (без Docker) — файл рядом с кодом. Внутри Docker-контейнера
# docker-compose.yml сам переопределяет это на sqlite:////app/data/couple_questions.db
# (volume backend_data), так что для Docker-запуска эту строку можно не трогать.
DATABASE_URL=sqlite:///./couple_questions.db

# Локально — адрес dev-сервера Next.js. На проде — точный адрес домена,
# например https://example.com (без слэша на конце, можно перечислить
# несколько через запятую). Поскольку в проде фронтенд и API теперь на
# одном домене (роутинг по путям через nginx), браузер видит их как один
# origin, и CORS практически не участвует — но переменную всё равно стоит
# выставить правильно на случай прямых обращений к backend в обход nginx.
CORS_ORIGINS=http://localhost:3000

# Секрет для одноразового получения прав администратора через
# POST /admin/claim — см. README, раздел "Админ-панель".
# Обязательно смените значение перед деплоем на реальный сервер!
ADMIN_SECRET_KEY=change_this_admin_secret
