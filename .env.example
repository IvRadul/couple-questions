# Переменные для docker-compose (подстановка ${VAR} в docker-compose.yml).
# Скопируйте в .env: cp .env.example .env

# Порты, которые будут проброшены на хост
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Публичный адрес backend API, который увидит браузер пользователя.
# Для локальной сборки — http://localhost:8000.
# Для реального сервера с доменом и HTTPS — см. DEPLOY.md и
# .env.production.example (там своя, продовая раскладка через nginx).
# Важно: это значение "запекается" в JS-бандл фронтенда при сборке образа,
# поменять его на лету после сборки нельзя — нужно пересобрать frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Необязательно: переопределить строку подключения к БД внутри backend-контейнера
# (по умолчанию используется SQLite в volume backend_data).
# Пример для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/couple_questions
# DATABASE_URL=sqlite:////app/data/couple_questions.db
