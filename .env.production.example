# Переменные для продакшен-стека (docker-compose.prod.yml).
# Скопируйте в .env: cp .env.production.example .env
# Подробная инструкция по выкладке на VDS — см. DEPLOY.md.

# Домен, на который уже должна указывать A-запись DNS этого сервера
# (используется и как DOMAIN, и как www.DOMAIN).
DOMAIN=example.com

# Email для уведомлений Let's Encrypt (истечение сертификата и т.п.)
LETSENCRYPT_EMAIL=you@example.com

# Публичный адрес backend API, который увидит браузер пользователя.
# ВАЖНО:
#   1) Обязательно с суффиксом /api (именно так его ждёт nginx-роутинг
#      в nginx/conf.d/app.conf.template — location /api/ и /api/ws/).
#   2) Это значение "запекается" в JS-бандл фронтенда на этапе сборки —
#      если поменяете домен, нужно пересобрать frontend:
#      docker compose -f docker-compose.prod.yml up -d --build frontend
NEXT_PUBLIC_API_URL=https://example.com/api

# Необязательно: переопределить строку подключения к БД внутри backend-контейнера
# (по умолчанию используется SQLite в volume backend_data).
# Пример для PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/couple_questions
