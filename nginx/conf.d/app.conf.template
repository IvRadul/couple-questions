# Шаблон конфигурации nginx для продакшена (один домен, роутинг по путям:
# / -> frontend, /api/ и /ws/ -> backend). Плейсхолдер __DOMAIN__
# подставляется скриптом scripts/render-nginx-config.sh на основе
# значения DOMAIN из корневого .env — см. DEPLOY.md. Итоговый файл
# (app.conf, без .template) генерируется рядом и в git не коммитится.
#
# __DOMAIN__ (без www) — канонический домен. www.__DOMAIN__ везде только
# редиректит на него (и по HTTP, и по HTTPS) — иначе браузер может открыть
# приложение на www, пока фронтенд обращается к API на голом домене (или
# наоборот), а это два РАЗНЫХ origin с точки зрения браузера => CORS-ошибки.

server {
    listen 80;
    server_name __DOMAIN__ www.__DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        # Редирект всегда на канонический (без www) хост, даже если зашли по HTTP на www.
        return 301 https://__DOMAIN__$request_uri;
    }
}

# www по HTTPS — тоже только редирект на канонический домен, само приложение
# здесь не отдаём. Сертификат общий (www.__DOMAIN__ включён как SAN при
# выпуске в init-letsencrypt.sh), поэтому TLS для этого блока работает.
server {
    listen 443 ssl http2;
    server_name www.__DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Встроенный DNS докера — без него nginx резолвит имена backend/frontend
    # ОДИН РАЗ при старте и кэширует IP на весь срок жизни воркера. После
    # `docker compose up -d --build` контейнеры backend/frontend получают
    # новые IP, а nginx (если его не перезапустить) продолжает стучаться в
    # старые — соединение рвётся на уровне TCP/TLS ещё до HTTP-ответа,
    # в браузере это выглядит как NS_ERROR_NET_* / "не удаётся установить
    # соединение". Чтобы этого не происходило при каждом деплое, используем
    # переменные в proxy_pass — тогда nginx резолвит имя заново на каждый
    # запрос (через resolver), а не один раз при старте.
    resolver 127.0.0.11 valid=10s;

    location / {
        set $frontend_upstream frontend:3000;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Более специфичный location, чем /api/ ниже — nginx выбирает самый
    # длинный совпадающий префикс, так что запросы вида /api/ws/... уходят
    # именно сюда и получают заголовки апгрейда до WebSocket. Это нужно,
    # если NEXT_PUBLIC_API_URL указывает на .../api (единая база для REST
    # и WS) — см. lib/websocket.ts на фронтенде.
    location /api/ws/ {
        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Прямой /ws/ (без префикса /api) оставлен для совместимости, если
    # NEXT_PUBLIC_API_URL когда-нибудь укажет на голый домен без /api.
    location /ws/ {
        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /docs {
        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream/docs;
        proxy_set_header Host $host;
    }

    location /openapi.json {
        set $backend_upstream backend:8000;
        proxy_pass http://$backend_upstream/openapi.json;
        proxy_set_header Host $host;
    }
}
